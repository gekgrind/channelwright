{
  "name": "channelwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "video:studio": "remotion studio src/video/index.ts",
    "video:render:sample": "remotion render src/video/index.ts ChannelwrightMaster renders/deterministic/channelwright-sample.mp4 --codec=h264 --pixel-format=yuv420p --muted",
    "video:render:audio": "tsx scripts/render-audio-sample.ts",
    "video:e2e:local": "tsx scripts/local-media-e2e.ts",
    "video:ffmpeg": "remotion ffmpeg",
    "video:ffprobe": "remotion ffprobe",
    "video:inspect": "tsx scripts/inspect-media.ts",
    "worker:render": "tsx src/server/rendering/worker-entry.ts",
    "worker:workflow": "node --conditions=react-server --import tsx src/server/workflows/worker-entry.ts",
    "gate:supabase:migrate": "tsx scripts/supabase-gate/migrate.ts",
    "gate:supabase:inspect": "tsx scripts/supabase-gate/inspect.ts",
    "gate:supabase:live": "tsx scripts/supabase-gate/live.ts",
    "gate:research:persisted": "tsx scripts/channel-research-persisted-live.ts",
    "gate:strategy:persisted": "tsx scripts/channel-strategy-persisted-live.ts",
    "gate:multimodel:live": "tsx scripts/multi-model-content-live.ts",
    "research:provider:live": "tsx scripts/channel-research-live.ts",
    "gate:videobrief:persisted": "tsx scripts/channel-video-brief-persisted-live.ts",
    "gate:videoscript:persisted": "tsx scripts/channel-video-script-persisted-live.ts",
    "gate:videoscript:disposable-pg": "tsx scripts/channel-video-script-disposable-pg.ts",
    "gate:videopackaging:disposable-pg": "tsx scripts/channel-video-packaging-disposable-pg.ts",
    "gate:videorelease:disposable-pg": "tsx scripts/channel-video-release-disposable-pg.ts",
    "gate:videoperformance:disposable-pg": "tsx scripts/channel-video-performance-disposable-pg.ts",
    "gate:videodiagnosis:disposable-pg": "tsx scripts/channel-video-diagnosis-disposable-pg.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.500",
    "@remotion/cli": "4.0.500",
    "@remotion/renderer": "4.0.500",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.500",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "pg": "^8.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
