# Use fixture-backed workflows without external calls. This flag is ignored when NODE_ENV=production.
CHANNELWRIGHT_MOCK_MODE=true
NEXT_PUBLIC_CHANNELWRIGHT_MOCK_MODE=true

# Signs fixture-mode session cookies so they cannot be forged. Use at least 32 characters.
# When unset, each server process generates an ephemeral secret and existing fixture sessions stop validating on restart.
CHANNELWRIGHT_MOCK_SESSION_SECRET=

# Supabase is required when mock mode is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public CAPTCHA widget settings. Match the provider configured in Supabase Auth.
# Supported values: turnstile or hcaptcha. The site key is public; the provider secret stays only in Supabase.
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Shared-project integration gate. Channelwright uses its own PostgreSQL schema and private bucket.
# The confirmations must exactly match the existing project's ref and the literal schema name.
CHANNELWRIGHT_SHARED_SUPABASE_URL=
CHANNELWRIGHT_SHARED_SUPABASE_ANON_KEY=
CHANNELWRIGHT_SHARED_SUPABASE_SERVICE_ROLE_KEY=
CHANNELWRIGHT_SHARED_DATABASE_URL=
# Download the project CA from Supabase Database Settings; verify-full is required by the gate.
CHANNELWRIGHT_SHARED_DATABASE_CA_PATH=
CHANNELWRIGHT_SHARED_PROJECT_REF=
CHANNELWRIGHT_SHARED_CONFIRM_PROJECT_REF=
CHANNELWRIGHT_SHARED_CONFIRM_SCHEMA=channelwright
CHANNELWRIGHT_GATE_SAMPLE_VIDEO_PATH=renders/deterministic/channelwright-sample.mp4

# Isolated render worker. The service-role key must exist only in trusted server/worker environments.
RENDER_WORKER_ID=
RENDER_LEASE_SECONDS=120
RENDER_POLL_INTERVAL_MS=2000
RENDER_WORK_ROOT=.data/render-work

# Durable strategic workflow worker. The worker runs only in a trusted service-role environment.
WORKFLOW_WORKER_ID=
WORKFLOW_LEASE_SECONDS=120
WORKFLOW_POLL_INTERVAL_MS=2000

# Technical audio QA. Subjective audio review remains a separate human gate.
AUDIO_LOUDNESS_TARGET_LUFS=-16
AUDIO_LOUDNESS_TOLERANCE_LU=2
AUDIO_TRUE_PEAK_MAX_DBFS=-1

# Provider-backed CHANNEL_RESEARCH and CHANNEL_STRATEGY. These secrets stay in
# trusted server/worker environments and never reach the browser bundle.
# Enable YouTube Data API v3 for the Google Cloud project that issued this API key.
YOUTUBE_DATA_API_KEY=
OPENAI_API_KEY=
#
# Model selection is REQUIRED for provider-backed execution. There is no built-in
# default model identifier: an unset model fails closed with AI_MODEL_NOT_CONFIGURED
# before any paid budget is reserved, rather than calling a nonexistent model.
# Set a model your OpenAI account can actually serve.
#
# Research synthesis model  <- OPENAI_SYNTHESIS_MODEL, else OPENAI_MODEL
# Research QA model         <- OPENAI_QA_MODEL, else the research synthesis model
# Strategy synthesis model  <- OPENAI_STRATEGY_SYNTHESIS_MODEL, else OPENAI_SYNTHESIS_MODEL, else OPENAI_MODEL
# Strategy QA model         <- OPENAI_STRATEGY_QA_MODEL, else OPENAI_QA_MODEL, else the strategy synthesis model
#
# Setting OPENAI_MODEL alone satisfies every path. Setting a distinct QA model
# reduces (but does not remove) generator/critic correlated-failure risk.
OPENAI_MODEL=
OPENAI_SYNTHESIS_MODEL=
OPENAI_QA_MODEL=
OPENAI_STRATEGY_SYNTHESIS_MODEL=
OPENAI_STRATEGY_QA_MODEL=
# Content intelligence synthesis <- OPENAI_CONTENT_SYNTHESIS_MODEL, else OPENAI_SYNTHESIS_MODEL, else OPENAI_MODEL
# Content intelligence QA        <- OPENAI_CONTENT_QA_MODEL, else OPENAI_QA_MODEL, else the content synthesis model
OPENAI_CONTENT_SYNTHESIS_MODEL=
OPENAI_CONTENT_QA_MODEL=

# --- Multi-model routing -----------------------------------------------------
# Channelwright owns the workflow, evidence, contracts, budgets, QA, and the final
# decision. Models are interchangeable specialists routed per role, so provider
# assignment can change on measured evidence without touching workflow code.
#
# Supported providers: openai, anthropic. Both credentials are server-only.
ANTHROPIC_API_KEY=
#
# Provider per role, resolved most specific first:
#   <NS>_<ROLE>_PROVIDER  ->  <NS>_DEFAULT_PROVIDER  ->  CHANNELWRIGHT_DEFAULT_PROVIDER  ->  openai
# Namespaces: CONTENT, RESEARCH, STRATEGY, VIDEO_BRIEF. Roles: GENERATOR, STRATEGIST, CRITIC,
# VIEWER_VALUE_REVIEWER, QA, REVISION.
#
# Verified starting split for CONTENT_INTELLIGENCE: one provider generates, a
# different provider critiques and QAs it, and Channelwright arbitrates.
CONTENT_GENERATOR_PROVIDER=openai
CONTENT_REVISION_PROVIDER=openai
CONTENT_CRITIC_PROVIDER=anthropic
CONTENT_QA_PROVIDER=anthropic
#
# Model per role, resolved most specific first:
#   <NS>_<ROLE>_MODEL  ->  <PROVIDER>_<NS>_MODEL  ->  <PROVIDER>_MODEL
# There is no final fallback: an unconfigured role raises AI_MODEL_NOT_CONFIGURED
# before any paid reservation. Set models your accounts can actually serve.
ANTHROPIC_MODEL=
ANTHROPIC_CONTENT_MODEL=
CONTENT_GENERATOR_MODEL=
CONTENT_CRITIC_MODEL=
CONTENT_QA_MODEL=
CONTENT_REVISION_MODEL=
#
# CHANNEL_VIDEO_BRIEF uses the same split: one provider designs the viewer promise
# and builds the brief, a different provider critiques and QAs it, and
# Channelwright arbitrates. The namespace is independent, so changing it cannot
# affect research, strategy, or content-intelligence behaviour.
VIDEO_BRIEF_GENERATOR_PROVIDER=openai
VIDEO_BRIEF_REVISION_PROVIDER=openai
VIDEO_BRIEF_CRITIC_PROVIDER=anthropic
VIDEO_BRIEF_QA_PROVIDER=anthropic
ANTHROPIC_VIDEO_BRIEF_MODEL=
OPENAI_VIDEO_BRIEF_MODEL=
VIDEO_BRIEF_GENERATOR_MODEL=
VIDEO_BRIEF_CRITIC_MODEL=
VIDEO_BRIEF_QA_MODEL=
VIDEO_BRIEF_REVISION_MODEL=
#
# CHANNEL_VIDEO_SCRIPT uses the same split: one provider drafts and revises the
# script, a different provider critiques and QAs it, and Channelwright arbitrates.
# The namespace is independent, so changing it cannot affect research, strategy,
# content-intelligence, or video-brief behaviour.
VIDEO_SCRIPT_GENERATOR_PROVIDER=openai
VIDEO_SCRIPT_REVISION_PROVIDER=openai
VIDEO_SCRIPT_CRITIC_PROVIDER=anthropic
VIDEO_SCRIPT_QA_PROVIDER=anthropic
ANTHROPIC_VIDEO_SCRIPT_MODEL=
OPENAI_VIDEO_SCRIPT_MODEL=
VIDEO_SCRIPT_GENERATOR_MODEL=
VIDEO_SCRIPT_CRITIC_MODEL=
VIDEO_SCRIPT_QA_MODEL=
VIDEO_SCRIPT_REVISION_MODEL=

# Operator-selected research budgets. Search calls use YouTube's separate granular search quota bucket.
CHANNEL_RESEARCH_MAX_SEARCH_QUERIES=2
CHANNEL_RESEARCH_MAX_PROVIDER_REQUESTS=8
CHANNEL_RESEARCH_MAX_VIDEOS=24
CHANNEL_RESEARCH_MAX_CHANNELS=12
CHANNEL_RESEARCH_CACHE_TTL_SECONDS=21600
CHANNEL_RESEARCH_PROVIDER_TIMEOUT_MS=20000
CHANNEL_RESEARCH_MODEL_TIMEOUT_MS=45000
CHANNEL_RESEARCH_MODEL_MAX_OUTPUT_TOKENS=6000
# Durable per-run ceilings shared by every internal retry and worker process.
CHANNEL_RESEARCH_MAX_AGGREGATE_PROVIDER_REQUESTS=12
CHANNEL_RESEARCH_MAX_AGGREGATE_PROVIDER_QUOTA_UNITS=500
CHANNEL_RESEARCH_MAX_AGGREGATE_SEARCHES=4
CHANNEL_RESEARCH_MAX_AGGREGATE_SYNTHESIS_CALLS=2
CHANNEL_RESEARCH_MAX_AGGREGATE_QA_CALLS=4
CHANNEL_RESEARCH_MAX_AGGREGATE_REVISION_CALLS=2
CHANNEL_RESEARCH_MAX_AGGREGATE_INPUT_TOKENS=250000
CHANNEL_RESEARCH_MAX_AGGREGATE_OUTPUT_TOKENS=24000
CHANNEL_RESEARCH_MAX_AGGREGATE_TOTAL_TOKENS=274000
CHANNEL_STRATEGY_MODEL_TIMEOUT_MS=60000
CHANNEL_STRATEGY_MODEL_MAX_OUTPUT_TOKENS=9000
CHANNEL_STRATEGY_MAX_AGGREGATE_SYNTHESIS_CALLS=1
CHANNEL_STRATEGY_MAX_AGGREGATE_QA_CALLS=2
CHANNEL_STRATEGY_MAX_AGGREGATE_REVISION_CALLS=1
CHANNEL_STRATEGY_MAX_AGGREGATE_INPUT_TOKENS=320000
CHANNEL_STRATEGY_MAX_AGGREGATE_OUTPUT_TOKENS=36000
CHANNEL_STRATEGY_MAX_AGGREGATE_TOTAL_TOKENS=356000
# Content intelligence fans out across approved content pillars. These defaults stay
# inside the database safety ceilings (36 provider requests, 1200 quota units, 12 searches),
# so no accounting migration is required to raise them within those bounds.
# search.list costs 100 quota units, which is what caps the search count.
CONTENT_INTELLIGENCE_MAX_PILLARS=6
CONTENT_INTELLIGENCE_MAX_QUERIES_PER_PILLAR=2
CONTENT_INTELLIGENCE_MAX_SEARCH_QUERIES=8
CONTENT_INTELLIGENCE_MAX_PROVIDER_REQUESTS=24
CONTENT_INTELLIGENCE_MAX_VIDEOS=50
CONTENT_INTELLIGENCE_MAX_CHANNELS=24
CONTENT_INTELLIGENCE_MAX_EVIDENCE_RECORDS=90
CONTENT_INTELLIGENCE_CACHE_TTL_SECONDS=21600
CONTENT_INTELLIGENCE_PROVIDER_TIMEOUT_MS=20000
CONTENT_INTELLIGENCE_MODEL_TIMEOUT_MS=90000
CONTENT_INTELLIGENCE_MODEL_MAX_OUTPUT_TOKENS=14000
CONTENT_INTELLIGENCE_MAX_AGGREGATE_PROVIDER_REQUESTS=24
CONTENT_INTELLIGENCE_MAX_AGGREGATE_PROVIDER_QUOTA_UNITS=900
CONTENT_INTELLIGENCE_MAX_AGGREGATE_SEARCHES=8
CONTENT_INTELLIGENCE_MAX_AGGREGATE_SYNTHESIS_CALLS=5
CONTENT_INTELLIGENCE_MAX_AGGREGATE_QA_CALLS=6
CONTENT_INTELLIGENCE_MAX_AGGREGATE_REVISION_CALLS=2
CONTENT_INTELLIGENCE_MAX_AGGREGATE_INPUT_TOKENS=600000
CONTENT_INTELLIGENCE_MAX_AGGREGATE_OUTPUT_TOKENS=60000
CONTENT_INTELLIGENCE_MAX_AGGREGATE_TOTAL_TOKENS=660000
# Video brief and video script perform no external retrieval, so their provider,
# quota, and search ceilings are fixed at zero; only model calls consume budget.
VIDEO_BRIEF_MODEL_TIMEOUT_MS=90000
VIDEO_BRIEF_MODEL_MAX_OUTPUT_TOKENS=16000
VIDEO_BRIEF_MAX_AGGREGATE_SYNTHESIS_CALLS=4
VIDEO_BRIEF_MAX_AGGREGATE_QA_CALLS=6
VIDEO_BRIEF_MAX_AGGREGATE_REVISION_CALLS=2
VIDEO_BRIEF_MAX_AGGREGATE_INPUT_TOKENS=500000
VIDEO_BRIEF_MAX_AGGREGATE_OUTPUT_TOKENS=60000
VIDEO_BRIEF_MAX_AGGREGATE_TOTAL_TOKENS=560000
VIDEO_SCRIPT_MODEL_TIMEOUT_MS=120000
# Output ceilings are reserved per call and role-specific so the full 12-call
# retry graph fits the aggregate/database output budget. Script-emitting roles
# (GENERATOR, REVISION) get the large allowance; review roles (CRITIC, QA) a
# small one. Worst case = 4*15000 + 8*4000 = 92000 <= 96000 <= 100000 (DB).
# REMOVED: VIDEO_SCRIPT_MODEL_MAX_OUTPUT_TOKENS (the old flat per-call ceiling).
# It is replaced by the two role-split vars below; setting it now fails fast with
# a migration error rather than being silently ignored. The resolved config also
# enforces 4*script + 8*review <= aggregate output <= 100000.
VIDEO_SCRIPT_SCRIPT_OUTPUT_TOKENS=15000
VIDEO_SCRIPT_REVIEW_OUTPUT_TOKENS=4000
# QA calls: normal no-retry path needs 4 (initial critic+QA, final critic+QA);
# the full allowed-retry path needs up to 8. Minimum accepted is 4.
VIDEO_SCRIPT_MAX_AGGREGATE_SYNTHESIS_CALLS=4
VIDEO_SCRIPT_MAX_AGGREGATE_QA_CALLS=8
VIDEO_SCRIPT_MAX_AGGREGATE_REVISION_CALLS=2
VIDEO_SCRIPT_MAX_AGGREGATE_INPUT_TOKENS=700000
VIDEO_SCRIPT_MAX_AGGREGATE_OUTPUT_TOKENS=96000
VIDEO_SCRIPT_MAX_AGGREGATE_TOTAL_TOKENS=796000

# Opt in only for the local live script; adds structured synthesis, independent QA, and a possible bounded revision.
CHANNEL_RESEARCH_LIVE_CHAIN=false
